{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    
    /* PATH ALIASES - ADD THIS SECTION */
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@config/*": ["config/*"],
      "@lib/*": ["lib/*"],
      "@utils/*": ["utils/*"],
      "@services/*": ["services/*"],
      "@controllers/*": ["controllers/*"],
      "@middleware/*": ["middleware/*"],
      "@types/*": ["types/*"],
      "@routes/*": ["routes/*"]
    },
    /* END PATH ALIASES */
    
    /* Module Resolution */
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["type.d.ts", "src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}